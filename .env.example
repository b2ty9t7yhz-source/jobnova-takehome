# Runtime files contain authentication and application state. Keep this path local.
JOBNOVA_RUNTIME_DIR=./runtime

# Optional browser setting. The CLI remains headed by default for safe review.
JOBNOVA_HEADLESS=false

# Optional encrypted remote session mode. Set all three together.
# The endpoint supports authenticated GET (404 when empty), PUT, and DELETE.
# JOBNOVA_SESSION_API_URL=https://sessions.example.com/v1/users/USER_ID/indeed
# JOBNOVA_SESSION_API_TOKEN=replace-with-a-short-lived-bearer-token
# Generate with: openssl rand -base64 32
# JOBNOVA_SESSION_ENCRYPTION_KEY=replace-with-base64-key

# Token used by the optional repository-provided HTTPS session vault.
# Keep it in the environment, never in command-line arguments or Git.
# JOBNOVA_VAULT_TOKEN=replace-with-a-long-random-bearer-token
