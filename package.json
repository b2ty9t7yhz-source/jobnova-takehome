{
  "name": "jobnova-takehome",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @jobnova/web",
    "dev:web": "npm run dev --workspace @jobnova/web",
    "cli": "tsx packages/automation/src/cli.ts",
    "demo:seed": "npm run cli -- demo:seed",
    "demo:status": "npm run cli -- demo:status",
    "demo:session": "npm run cli -- demo:session",
    "demo:workflow": "npm run cli -- demo:workflow",
    "reviewer:demo": "node scripts/reviewer-demo.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "test:browser": "npm run test:browser --workspace @jobnova/automation",
    "test:e2e:web": "playwright test --config playwright.web.config.ts",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check:versions && npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.62.1",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "jsdom": "29.1.1",
    "typescript-eslint": "8.67.0"
  }
}
